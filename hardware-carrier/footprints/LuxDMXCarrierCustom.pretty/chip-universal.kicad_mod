(footprint "chip-universal"
  (version 20240108)
  (generator "luxdmx-carrier-rework_lands")
  (layer "F.Cu")
  (descr "Universal hand-solder chip land, copper 0.30 to 2.30 mm off centre. Takes 0402, 0603, 0805 and 1206, and a 1210 whose 2.5 mm width overhangs the 1.8 mm pad. Gap between the pads is 0.60 mm, about what a stock 0603 land has. Hand soldering only: the land is far longer than any of the parts, so nothing self-aligns in reflow.")
  (tags "resistor capacitor universal handsolder 0402 0603 0805 1206")
  (attr smd)
  (fp_text reference "REF**" (at 0 -2.100) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))
  (fp_text value "chip-universal" (at 0 2.100) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.15))))
  (fp_line (start -2.450 -1.200) (end 2.450 -1.200) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -2.450 1.200) (end 2.450 1.200) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -2.450 -1.200) (end -2.450 1.200) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start 2.450 -1.200) (end 2.450 1.200) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_rect (start -2.600 -1.400) (end 2.600 1.400) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_rect (start -2.300 -0.900) (end 2.300 0.900) (stroke (width 0.10) (type solid)) (fill none) (layer "F.Fab"))
  (pad "1" smd rect (at -1.300 0) (size 2.000 1.800) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "2" smd rect (at 1.300 0) (size 2.000 1.800) (layers "F.Cu" "F.Paste" "F.Mask"))
)
