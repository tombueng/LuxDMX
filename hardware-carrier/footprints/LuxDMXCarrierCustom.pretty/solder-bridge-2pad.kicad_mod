(footprint "solder-bridge-2pad"
  (version 20240108)
  (generator "luxdmx-carrier-add_solder_bridge")
  (layer "F.Cu")
  (descr "Two rectangular pads 0.3 mm apart for a solder blob. Sits on the back under the polyfuse so the fuse can be replaced by a bridge. Pads are 1.0 x 3.0 mm, tall on purpose: it carries the full pixel current when bridged, and a tall blob is easier to flood than a square one. No paste layer, this is a hand job.")
  (tags "solder jumper bridge fuse hand-solder")
  (attr smd exclude_from_pos_files exclude_from_bom)
  (fp_text reference "REF**" (at 0 -2.900) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))
  (fp_text value "solder-bridge-2pad" (at 0 2.900) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.15))))
  (fp_line (start -1.400 -1.750) (end 1.400 -1.750) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -1.400 1.750) (end 1.400 1.750) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_rect (start -1.400 -1.750) (end 1.400 1.750) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (pad "1" smd rect (at -0.650 0) (size 1.000 3.000) (layers "F.Cu" "F.Mask"))
  (pad "2" smd rect (at 0.650 0) (size 1.000 3.000) (layers "F.Cu" "F.Mask"))
)
