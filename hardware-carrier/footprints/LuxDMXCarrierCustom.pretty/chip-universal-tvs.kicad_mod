(footprint "chip-universal-tvs"
  (version 20240108)
  (generator "luxdmx-carrier-rework_lands")
  (layer "F.Cu")
  (descr "Universal hand-solder chip land, copper 0.30 to 2.90 mm off centre. Takes 0603 to 1206, SOD-123 / SOD-123F / SOD-123FL, and DO-214AC (SMA), whose feet reach 2.80 mm. Gap between the pads is 0.60 mm, about what a stock 0603 land has. Hand soldering only: the land is far longer than any of the parts, so nothing self-aligns in reflow.")
  (tags "tvs diode universal handsolder SOD-123 SMA DO-214AC 1206")
  (attr smd)
  (fp_text reference "REF**" (at 0 -2.100) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))
  (fp_text value "chip-universal-tvs" (at 0 2.100) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.15))))
