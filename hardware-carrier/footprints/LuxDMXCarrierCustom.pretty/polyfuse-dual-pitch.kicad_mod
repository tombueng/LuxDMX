(footprint "polyfuse-dual-pitch"
  (version 20240108)
  (generator "luxdmx-carrier-gen_polyfuse_dual")
  (layer "F.Cu")
  (descr "Bourns radial polyfuse land taking both lead pitches, plus solder-bridge pads on the back. Use the MF-R series at 24 V: it is rated 30 V, while MF-RHT and MF-RG are only 16 V above 1 A. Middle hole = 5.08 mm (MF-R110..R400, up to Ihold 4 A / Itrip 8 A), right hole = 10.2 mm (MF-R500..R900, up to Ihold 9 A / Itrip 18 A). MF-R1100 drops back to 16 V, so 9 A is the ceiling on a 24 V rail. At 12 V the 16 V parts fit the same holes and reach 13 A. Holes 1.2 mm clear the 0.81 mm MF-R lead. Bridge pads 4.0 mm tall, 0.3 mm apart on B.Cu, each running into its own hole: leave the fuse off and blob them for an unfused board. Hole offsets generated from the KiCad Bourns footprints and checked against the MF-R datasheet pitches.")
  (tags "polyfuse pptc fuse dual-pitch solder-bridge hand-solder")
  (attr through_hole)
  (fp_text reference "REF**" (at -6.70 -2.65) (layer "F.SilkS") (effects (font (size 0.9 0.9) (thickness 0.15)) (justify left)))
  (fp_text value "polyfuse-dual-pitch" (at -6.70 3.85) (layer "F.Fab") (effects (font (size 0.9 0.9) (thickness 0.15)) (justify left)))
  (fp_rect (start -6.250 -1.450) (end 11.350 2.650) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -7.200 -1.750) (end 17.400 2.950) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -6.700 -1.250) (end 16.900 2.450) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -6.950 -1.500) (end 17.150 2.700) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_text user "4A/30V" (at 5.100 3.850) (layer "F.SilkS") (effects (font (size 0.7 0.7) (thickness 0.15))))
  (fp_text user "9A/30V" (at 10.200 3.850) (layer "F.SilkS") (effects (font (size 0.7 0.7) (thickness 0.15))))
  (fp_text user "BRIDGE" (at 2.550 -2.400) (layer "B.SilkS") (effects (font (size 0.7 0.7) (thickness 0.15)) (justify mirror)))
  (pad "1" thru_hole circle (at 0.000 0.000) (size 2.2 2.2) (drill 1.2) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 5.100 1.200) (size 2.2 2.2) (drill 1.2) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 10.200 1.200) (size 2.2 2.2) (drill 1.2) (layers "*.Cu" "*.Mask"))
  (pad "1" smd rect (at 1.200 0.600) (size 2.400 4.0) (layers "B.Cu" "B.Mask"))
  (pad "2" smd rect (at 3.900 0.600) (size 2.400 4.0) (layers "B.Cu" "B.Mask"))
)
