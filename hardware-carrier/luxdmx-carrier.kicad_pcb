	(footprint "chip-universal"
		(layer "B.Cu")
		(uuid "0539869b-4d15-4108-bc4d-a1b3850b3776")
		(at 138.2425 89.4 180)
		(descr "Universal hand-solder chip land, copper 0.30 to 2.30 mm off centre. Takes 0402, 0603, 0805 and 1206, and a 1210 whose 2.5 mm width overhangs the 1.8 mm pad. Gap between the pads is 0.60 mm, about what a stock 0603 land has. Hand soldering only: the land is far longer than any of the parts, so nothing self-aligns in reflow.")
