# SKiDL byproducts (regenerated by luxdmx.py)
*.erc
*.log
*_sklib.py

# regenerable / per-user
fab/
_cpl_raw.csv
*.kicad_prl
*-backups/

# VS Code local history (embedded repo)
.history/
# stale loose gerber export (deliverable is the .zip)
gerbers/

# routing toolchain binaries (FR2 jar + portable JDK25) — large, downloadable
tools/

# All the .py now live in scripts/. One-off / operational scripts stay LOCAL, not in git: the committed
# board (luxdmx.kicad_pcb) is the artifact. Only the design source, the reproducible build pipeline +
# generators, and the validation gates are tracked. New scratch scripts are auto-ignored by the *.py rule.
#
# The five add_*/fix_edge silk scripts were dropped from this whitelist: they WRITE the board, they already
# did their job (the silk is in the .kicad_pcb), and the board has since been hand-adjusted, so re-running
# them would destroy that. They stay local under scripts/ if you need to read them.
*.py
!luxdmx.py
!hw_version.py
!csv_to_xlsx.py
!gen_bom_from_board.py
!gen_gerbers.py
!gen_cpl.py
!gen_schematic.py
!build_v3.py
!sync_board.py
!rebuild_iso.py
!escape_connectors.py
!autoroute_fr2.py
!cleanup_pads.py
!tighten_poe_void.py
!normalize_silk.py
!validate_connectivity.py
!validate_geometry.py
!validate_placement.py
!validate_electrical.py
!validate_tbu_iso.py
!validate_critical.py
# 2026-07-19 mis-plug gate: J4/J6 are the same connector, so their power pins must stay identical
!validate_header_parity.py
# 2026-07-01 reproducible routing pipeline (route_all.sh) + the impedance/partial-net steps
!route_tbu.py
!setup_netclasses.py
!finish_partial.py
!widen_eth.py
