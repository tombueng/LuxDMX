  </Fixture>
  <Fixture>
   <Manufacturer>Stairville</Manufacturer>
   <Model>LED PAR 36 COB RGBW 12W</Model>
   <Mode>4 channel</Mode>
   <ID>1</ID>
   <Name>PAR left</Name>
   <Universe>0</Universe>
   <Address>10</Address>
