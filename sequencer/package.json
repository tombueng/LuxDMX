    "@types/three": "0.170.0",
    "ajv": "^8.17.1",
    "axe-core": "4.11.0",
    "happy-dom": "21.0.4",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "dependencies": {
    "fflate": "0.8.3",
