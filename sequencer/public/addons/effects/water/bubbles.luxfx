{
 "format": "luxdmx-effect",
 "formatVersion": 1,
 "id": "luxdmx.bubbles",
 "version": "1.0.0",
 "name": "Bubbles",
 "author": {
  "name": "LuxDMX",
  "url": "https://github.com/tombueng/LuxDMX"
 },
 "license": "MIT",
 "description": "Bubbles rising through blue water, wobbling as they go.",
 "tags": [
  "water"
 ],
 "category": "pixel",
 "fits": [
  "ring",
  "disc",
  "matrix"
 ],
 "uses": [
  "speed",
  "level",
  "range",
  "contrast",
  "orientation"
 ],
 "params": [],
 "defaults": {
  "speed": 8,
  "tempo": false,
  "spread": 0
 },
 "code": {
  "lang": "luxfx-1",
  "pixel": "let v = maxof(k, 12, gauss(dist(sx, sy, random(k, 1) * 1.6 - 0.8 + 0.08 * sin(t * 2 + k), frac(t * (0.15 + random(k, 2) * 0.2) + random(k, 3)) * 2.6 - 1.3) - (0.06 + random(k, 4) * 0.08), 0.03))\nrgb(0.6, 0.9, 1) * v + rgb(0, 0.07, 0.2)"
 }
}
