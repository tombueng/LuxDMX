{
 "format": "luxdmx-effect",
 "formatVersion": 1,
 "id": "luxdmx.heartbeat",
 "version": "1.0.0",
 "name": "Heartbeat",
 "author": {
  "name": "LuxDMX",
  "url": "https://github.com/tombueng/LuxDMX"
 },
 "license": "MIT",
 "description": "A big red heart beating twice, resting, beating again.",
 "tags": [
  "love"
 ],
 "category": "pixel",
 "fits": [
  "ring",
  "disc",
  "matrix"
 ],
 "uses": [
  "speed",
  "level",
  "range",
  "contrast"
 ],
 "params": [
  {
   "id": "pulseRate",
   "name": "Pulse",
   "description": "Heartbeats a minute",
   "type": "number",
   "min": 30,
   "max": 180,
   "step": 1,
   "default": 55,
   "unit": " bpm"
  }
 ],
 "defaults": {
  "speed": 8,
  "tempo": false,
  "spread": 0
 },
 "code": {
  "lang": "luxfx-1",
  "frame": "let b = frac(t * pulseRate / 60)\nlet pulse = max(gauss(b - 0.05, 0.04), 0.7 * gauss(b - 0.25, 0.05))",
  "pixel": "fn heart(x, y) = smoothstep(0.05, -0.05, (x * x + y * y - 1) ^ 3 - x * x * y ^ 3)\nlet s = 1.3 / (0.85 + 0.15 * pulse)\nlet inside = heart(sx * s, sy * s + 0.25)\nrgb(1, 0.04, 0.18) * inside * (0.45 + 0.55 * pulse) + rgb(0.12, 0, 0.03) * pulse"
 }
}
