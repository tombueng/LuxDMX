{
 "format": "luxdmx-effect",
 "formatVersion": 1,
 "id": "luxdmx.love-burst",
 "version": "1.0.0",
 "name": "Love burst",
 "author": {
  "name": "LuxDMX",
  "url": "https://github.com/tombueng/LuxDMX"
 },
 "license": "MIT",
 "description": "A heart grows, bursts into sparks and comes together again.",
 "tags": [
  "love"
 ],
 "category": "pixel",
 "fits": [
  "ring",
  "disc",
  "matrix"
 ],
 "uses": [
  "speed",
  "level",
  "range",
  "contrast",
  "orientation"
 ],
 "params": [],
 "defaults": {
  "speed": 6,
  "tempo": false,
  "spread": 0
 },
 "code": {
  "lang": "luxfx-1",
  "pixel": "fn heart(x, y) = smoothstep(0.05, -0.05, (x * x + y * y - 1) ^ 3 - x * x * y ^ 3)\nlet grow = smoothstep(0, 0.45, c)\nlet burst = smoothstep(0.5, 0.95, c)\nlet s = 1.4 / max(0.2, grow)\nlet whole = heart(sx * s, sy * s + 0.25) * (c < 0.5)\nlet sparks = maxof(k, 20, gauss(dist(sx, sy, sin(k * 2.4) * burst * 1.2, cos(k * 2.4) * burst * 1.2), 0.07)) * (c >= 0.5) * (1 - burst * 0.7)\nrgb(1, 0.08, 0.3) * whole + rgb(1, 0.6, 0.75) * sparks"
 }
}
