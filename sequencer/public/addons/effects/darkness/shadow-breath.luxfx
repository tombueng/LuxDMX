{
 "format": "luxdmx-effect",
 "formatVersion": 1,
 "id": "luxdmx.shadow-breath",
 "version": "1.0.0",
 "name": "Shadow breath",
 "author": {
  "name": "LuxDMX",
  "url": "https://github.com/tombueng/LuxDMX"
 },
 "license": "MIT",
 "description": "A dark violet that breathes, barely there.",
 "tags": [
  "darkness"
 ],
 "category": "pixel",
 "fits": [
  "ring",
  "disc",
  "matrix"
 ],
 "uses": [
  "speed",
  "level",
  "range",
  "contrast",
  "orientation"
 ],
 "params": [],
 "defaults": {
  "speed": 8,
  "tempo": false,
  "spread": 0
 },
 "code": {
  "lang": "luxfx-1",
  "pixel": "let f = fbm(sx * 1.8 + t * 0.06, sy * 1.8 - t * 0.04)\nrgb(0.3, 0.05, 0.45) * (0.08 + 0.55 * wave(t / 6) * smoothstep(0.35, 0.75, f) * (1 - rad * 0.4))"
 }
}
