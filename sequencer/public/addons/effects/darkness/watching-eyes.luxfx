{
 "format": "luxdmx-effect",
 "formatVersion": 1,
 "id": "luxdmx.watching-eyes",
 "version": "1.0.0",
 "name": "Watching eyes",
 "author": {
  "name": "LuxDMX",
  "url": "https://github.com/tombueng/LuxDMX"
 },
 "license": "MIT",
 "description": "Red eyes open in the dark, look, blink and are gone.",
 "tags": [
  "darkness"
 ],
 "category": "pixel",
 "fits": [
  "ring",
  "disc",
  "matrix"
 ],
 "uses": [
  "speed",
  "level",
  "range",
  "contrast",
  "orientation"
 ],
 "params": [],
 "defaults": {
  "speed": 8,
  "tempo": false,
  "spread": 0
 },
 "code": {
  "lang": "luxfx-1",
  "pixel": "fn when(k) = t / 5 + random(k, 3)\nfn open(k) = (frac(when(k)) > 0.15) * (frac(when(k)) < 0.85) * (frac(t * 0.6 + k * 0.37) > 0.05)\nfn ex(k) = random(k, floor(when(k))) * 1.3 - 0.65\nfn ey(k) = random(k + 9, floor(when(k))) * 1.3 - 0.65\nfn eye(x, y) = gauss(dist(sx, sy, x, y), 0.07)\nlet v = maxof(k, 5, open(k) * (eye(ex(k) - 0.12, ey(k)) + eye(ex(k) + 0.12, ey(k))))\nrgb(1, 0.04, 0) * v"
 }
}
