{
 "format": "luxdmx-effect",
 "formatVersion": 1,
 "id": "luxdmx.drizzle",
 "version": "1.0.0",
 "name": "Drizzle",
 "author": {
  "name": "LuxDMX",
  "url": "https://github.com/tombueng/LuxDMX"
 },
 "license": "MIT",
 "description": "Fine drops falling, slow and soft blue.",
 "tags": [
  "rain"
 ],
 "category": "pixel",
 "fits": [
  "ring",
  "disc",
  "matrix"
 ],
 "uses": [
  "speed",
  "level",
  "range",
  "contrast",
  "orientation"
 ],
 "params": [
  {
   "id": "drops",
   "name": "Drops",
   "description": "How much rain",
   "type": "number",
   "min": 0,
   "max": 1,
   "step": 0.01,
   "default": 0.3
  }
 ],
 "defaults": {
  "speed": 8,
  "tempo": false,
  "spread": 0
 },
 "code": {
  "lang": "luxfx-1",
  "pixel": "let col = floor((sx + 1) * (3 + drops * 14))\nlet y = 1.25 - frac(t * (0.5 + random(col, 1) * 0.5) + random(col, 2)) * 2.5\nlet d = sy - y\nlet drop = d > 0 && d < 0.35 ? 1 - d / 0.35 : 0\nrgb(0.3, 0.55, 1) * drop * 0.85 + rgb(0, 0.01, 0.05)"
 }
}
