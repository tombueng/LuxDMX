{
 "format": "luxdmx-effect",
 "formatVersion": 1,
 "id": "luxdmx.eclipse",
 "version": "1.0.0",
 "name": "Eclipse",
 "author": {
  "name": "LuxDMX",
  "url": "https://github.com/tombueng/LuxDMX"
 },
 "license": "MIT",
 "description": "The moon slides over the sun, the corona flares round it, and it moves on. A story; Speed is its length.",
 "tags": [
  "sun"
 ],
 "category": "pixel",
 "fits": [
  "ring",
  "disc",
  "matrix"
 ],
 "uses": [
  "speed",
  "level",
  "range",
  "contrast",
  "orientation"
 ],
 "params": [],
 "defaults": {
  "speed": 30,
  "tempo": false,
  "spread": 0
 },
 "code": {
  "lang": "luxfx-1",
  "pixel": "let mx = -2 + 4 * c\nlet cover = clamp(1 - abs(mx) / 1.1)\nlet sun = rad < 0.55\nlet moon = dist(sx, sy, mx, 0) < 0.57\nlet corona = gauss(rad - 0.6, 0.08 + 0.12 * cover) * cover * (0.7 + 0.3 * noise(ang * 20, t))\nsun && !moon ? rgb(1, 0.85, 0.4) * (1 - cover * 0.5) : rgb(1, 0.95, 0.85) * corona"
 }
}
