{
 "format": "luxdmx-effect",
 "formatVersion": 1,
 "id": "luxdmx.grass",
 "version": "1.0.0",
 "name": "Grass in the wind",
 "author": {
  "name": "LuxDMX",
  "url": "https://github.com/tombueng/LuxDMX"
 },
 "license": "MIT",
 "description": "Blades of grass swaying in the wind under a light sky.",
 "tags": [
  "nature"
 ],
 "category": "pixel",
 "fits": [
  "ring",
  "disc",
  "matrix"
 ],
 "uses": [
  "speed",
  "level",
  "range",
  "contrast",
  "orientation"
 ],
 "params": [],
 "defaults": {
  "speed": 8,
  "tempo": false,
  "spread": 0
 },
 "code": {
  "lang": "luxfx-1",
  "pixel": "let sway = 0.25 * sin(t * 1.5 + sx * 2) * (sy + 1) / 2\nlet blade = wave((sx - sway) * 8)\nlet top = -1 + 0.8 + random(floor((sx + 1) * 8), 1) * 0.8\nlet g = blade * (sy < top)\nhsv(0.28, 0.9, g * (0.4 + 0.6 * (sy + 1) / 2)) + rgb(0.3, 0.6, 1) * 0.15 * (sy >= top)"
 }
}
