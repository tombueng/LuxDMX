 },
 "license": "MIT",
 "description": "Deep blue dark, with little lights drifting by.",
 "tags": [
  "sea"
 ],
 "category": "pixel",
 "fits": [
  "ring",
  "disc",
  "matrix"
 ],
 "uses": [
  "speed",
  "level",
  "range",
  "contrast",
  "orientation"
 ],
 "params": [],
 "defaults": {
  "speed": 8,
  "tempo": false,
  "spread": 0
 },
 "code": {
  "lang": "luxfx-1",
  "pixel": "let glow = maxof(k, 16, gauss(dist(sx, sy, random(k, 1) * 1.8 - 0.9 + 0.1 * sin(t * 0.3 + k), random(k, 2) * 1.8 - 0.9 + 0.1 * cos(t * 0.25 + k)), 0.05) * wave(t * 0.4 + random(k, 3)))\nrgb(0, 0.03, 0.12) * (0.5 + 0.5 * fbm(sx * 2, sy * 2 + t * 0.05)) + rgb(0.2, 1, 0.9) * glow"
 }
}
